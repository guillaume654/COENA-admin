# MongoDB Atlas — COENA wine list transactions (read-only access is enough).
# Leave empty to keep the UI empty.
MONGODB_URI=
MONGODB_DB=DigitalMenu-Database
# Venue shown in the app: the `owner_id` of its transactions.
COENA_OWNER_ID=
# Time zone used to display transaction dates.
COENA_TIMEZONE=Europe/Paris
# Set to 1 to show the two sample transactions instead of real data.
COENA_DEMO_DATA=0
