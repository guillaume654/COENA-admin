# COENA backend (AWS API Gateway). Users sign in with their COENA account through it.
# Live: https://q1a21h275f.execute-api.eu-west-1.amazonaws.com/prod
COENA_API_URL=
# Encrypts the session cookie. At least 32 random characters, e.g. `openssl rand -hex 32`.
# Changing it signs everyone out.
SESSION_SECRET=
# Time zone used to display transaction dates.
COENA_TIMEZONE=Europe/Paris
# Set to 1 (and leave COENA_API_URL empty) to preview with two sample transactions, without login.
COENA_DEMO_DATA=0
